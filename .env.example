# Database connection (SQLite relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Optional LLM Configuration
# If OPENAI_API_KEY is unset or empty, the app runs in zero-configuration Demo Mode using the deterministic rule-based planner.
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"

# Environment
NODE_ENV="development"
